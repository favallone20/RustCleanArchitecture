# Environment Configuration Example
# Copy this file to .env and adjust values as needed

# Environment (development, staging, production)
ENVIRONMENT=development
# Alternative: ENV=development

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Database Configuration
DATABASE_TYPE=in-memory
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_MAX_CONNECTIONS=10

# Logging Configuration
LOG_LEVEL=info
# RUST_LOG=debug  # Alternative to LOG_LEVEL
LOG_JSON=false  # Set to true for JSON formatted logs

# Feature Flags
FEATURE_EVENTS=false  # Enable domain events system
FEATURE_METRICS=false  # Enable metrics collection
